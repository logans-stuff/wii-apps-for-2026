diff --git a/src/mesh/CryptoEngine.cpp b/src/mesh/CryptoEngine.cpp
index 292adcd..8415917 100644
--- a/src/mesh/CryptoEngine.cpp
+++ b/src/mesh/CryptoEngine.cpp
@@ -592,9 +592,12 @@ void CryptoEngine::initNonce(uint32_t fromNode, uint64_t packetId, uint32_t extr
 {
     memset(nonce, 0, sizeof(nonce));
 
-    // use memcpy to avoid breaking strict-aliasing
-    memcpy(nonce, &packetId, sizeof(uint64_t));
-    memcpy(nonce + sizeof(uint64_t), &fromNode, sizeof(uint32_t));
+    // packet id then sender, both little-endian on every host (byte-wise, so
+    // big-endian builds produce the same nonce as the rest of the mesh)
+    for (size_t i = 0; i < sizeof(uint64_t); i++)
+        nonce[i] = (uint8_t)(packetId >> (8 * i));
+    for (size_t i = 0; i < sizeof(uint32_t); i++)
+        nonce[sizeof(uint64_t) + i] = (uint8_t)(fromNode >> (8 * i));
     if (extraNonce)
         memcpy(nonce + sizeof(uint32_t), &extraNonce, sizeof(uint32_t));
 }
