diff --git a/src/mesh/RadioInterface.h b/src/mesh/RadioInterface.h
index 67870d0..694a666 100644
--- a/src/mesh/RadioInterface.h
+++ b/src/mesh/RadioInterface.h
@@ -28,6 +28,14 @@ typedef struct _meshtastic_Config_LoRaConfig meshtastic_Config_LoRaConfig;
 #define PACKET_FLAGS_HOP_START_MASK 0xE0
 #define PACKET_FLAGS_HOP_START_SHIFT 5
 
+// The header's multi-byte fields are little-endian on the wire. Convert at the
+// radio buffer so big-endian hosts (the Wii's PowerPC) interoperate.
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#define MESH_WIRE32(x) __builtin_bswap32(x)
+#else
+#define MESH_WIRE32(x) (x)
+#endif
+
 /**
  * This structure has to exactly match the wire layout when sent over the radio link.  Used to keep compatibility
  * with the old radiohead implementation.
